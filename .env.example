# --- required -------------------------------------------------------------
MONGODB_URI=                 # use a DB user with readWrite on this database only
JWT_SECRET=                  # >= 32 random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=production
# Exact browser origin(s) of the storefront, comma separated, no trailing slash. Used for CORS + CSRF origin checks.
CLIENT_ORIGIN=https://your-domain.example
# Number of reverse-proxy hops in front of Node (so rate limits see real client IPs). 1 on most PaaS.
TRUST_PROXY=1

# --- optional -------------------------------------------------------------
PORT=10000
GOOGLE_CLIENT_ID=            # server-side token verification
VITE_GOOGLE_CLIENT_ID=       # same value, exposed to the browser (public by design)
# Safety list for server/scripts/provision-admin.js (full, exact emails); also receives order alert emails.
ADMIN_EMAILS=

# --- Twilio WhatsApp order alerts (optional) -----------------------------
TWILIO_SID=                  # your Twilio Account SID
TWILIO_AUTH=                 # your Twilio Auth Token
TWILIO_WHATSAPP_FROM=        # configured WhatsApp sender in E.164 format, e.g. +14155238886 for the sandbox
ADMIN_PHONE=                 # admin WhatsApp number in E.164 format, e.g. +9779800000000
# Removed: ADMIN_USERNAME / ADMIN_PASSWORD (no longer read; delete them from your environment).
